[Unit]
Description=Prometheus Node Exporter (Podman)
Wants=network-online.target
After=network-online.target

[Service]
ExecStartPre=-/usr/bin/podman rm -f node_exporter
ExecStart=/usr/bin/podman run --rm --name node_exporter \
    --net=host --pid=host \
    -v /:/host:ro,rslave \
    {{ image }}:{{ tag }} \
    --path.rootfs=/host \
    --web.listen-address=:{{ port }}
ExecStop=/usr/bin/podman stop -t 5 node_exporter
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
